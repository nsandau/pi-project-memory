{
  "name": "pi-project-memory",
  "version": "0.1.0",
  "description": "Project-scoped durable memory extension for Pi using Markdown and ripgrep",
  "type": "module",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.3.11",
  "keywords": ["pi-package", "pi", "memory", "ripgrep"],
  "files": ["index.ts", "src/", "README.md", "LICENSE"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.2",
    "@earendil-works/pi-coding-agent": ">=0.80.2",
    "@earendil-works/pi-tui": ">=0.80.2",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^24.0.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
